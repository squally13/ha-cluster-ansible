---
# Konfiguracja ansible-lint (R12) — profil produkcyjny, bez wyjątków bez uzasadnienia
profile: production

exclude_paths:
  - .lab/
  - .vagrant/
  - specs/
  - .specify/
  - .claude/
  - .github/
  # Zaszyfrowany Ansible Vault (etap 2, R7) — treść nie jest YAML-em do lintowania
  - inventories/lab/group_vars/all/vault.yml

# Kolekcje instaluje CI / pre-commit z requirements.yml
offline: false
